# Rushes local development settings
#
# 1. 複製本檔案為 .env，再按需要填值；不要把真實密鑰提交到 git。
# 2. 啟動腳本 scripts/dev_all.sh 會自動讀取倉庫根目錄的 .env；
#    已 export 的同名變數永遠優先。
# 3. 只填寫正在使用的 provider 相關項目；不要把多個 provider 的密鑰
#    同時填在同一份設定內。

# ─────────────────────────────────────────────────────────────
# 聊天 / 視覺模型（必須填寫其中一個 provider 的 key）
# ─────────────────────────────────────────────────────────────

# 選擇聊天／視覺供應商：nous | dashscope | ark | openrouter
RUSHES_CHAT_PROVIDER=nous

# ── Nous Research（預設；OpenAI-compatible endpoint，聊天與視覺共用同一組 key）
RUSHES_NOUS_API_KEY=
RUSHES_NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
# 預設模型同時支援 image + tools；如要切換其他 Nous 模型，請確認兩者均受支援。
RUSHES_NOUS_CHAT_MODEL=deepseek/deepseek-v4.1-flash
RUSHES_NOUS_VISION_MODEL=deepseek/deepseek-v4.1-flash

# ── OpenRouter（保留作切換備選）
# RUSHES_OPENROUTER_API_KEY=
# RUSHES_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# RUSHES_OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4.1-flash
# RUSHES_OPENROUTER_VISION_MODEL=deepseek/deepseek-v4.1-flash

# ── DashScope（阿里百煉，保留作切換備選）
# RUSHES_DASHSCOPE_API_KEY=
# RUSHES_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RUSHES_QWEN_CHAT_MODEL=qwen3.7-max
# RUSHES_QWEN_VISION_MODEL=qwen3.7-plus
# RUSHES_DASHSCOPE_ASR_MODEL=fun-asr-flash-2026-06-15

# ── Ark（火山方舟，保留作切換備選）
# RUSHES_ARK_API_KEY=
# RUSHES_ARK_CHAT_MODEL=
# RUSHES_ARK_VISION_MODEL=

# ─────────────────────────────────────────────────────────────
# 語音辨識
# ─────────────────────────────────────────────────────────────
# 預設在 Apple Silicon Mac 本機運行 MLX Whisper。首次啟動會在背景下載及暖機模型；
# 素材匯入與其他剪接功能毋須等待。失敗時可在素材面板重試，不會自動上載音訊到雲端。
RUSHES_ASR_PROVIDER=local
RUSHES_LOCAL_STT_MODEL=mlx-community/whisper-large-v3-mlx

# 如要明確改用 DashScope 雲端 ASR，取消以下註解並填入上方 DashScope key：
# RUSHES_ASR_PROVIDER=dashscope
# RUSHES_DASHSCOPE_ASR_MODEL=fun-asr-flash-2026-06-15

# ─────────────────────────────────────────────────────────────
# 本機檔案系統 / 工作區
# ─────────────────────────────────────────────────────────────
# 允許匯入本機素材的根目錄；留空或不設定即自動採用目前用戶的 Home、
# Movies、Desktop 以及 macOS 的 /Volumes。多個絕對路徑以 :（macOS/Linux）
# 或 ;（Windows）分隔。已 export 的同名環境變數永遠優先於本檔案。
# RUSHES_FS_ROOTS=/Users/you/Movies:/Volumes/External
